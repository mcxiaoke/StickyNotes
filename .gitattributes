# 统一行尾：仓库内一律存储 LF，避免跨平台/跨工具编辑产生整文件级 diff 噪音
* text=auto eol=lf

*.cs      text eol=lf
*.xaml    text eol=lf
*.csproj  text eol=lf
*.props   text eol=lf
*.slnx    text eol=lf
*.ps1     text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.ini     text eol=lf
*.yml     text eol=lf
*.cmd     text eol=lf

# 二进制文件不做任何行尾/编码转换
*.db      binary
*.png     binary
*.ico     binary
*.exe     binary
*.dll     binary
*.snk     binary
