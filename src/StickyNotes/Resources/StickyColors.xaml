<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         Fluent 语义系统画刷 · Material Design 3 语义色
         色源：temp/material-theme.json（Material Theme Builder 导出，seed #0064B5）
         本轮仅落地 light 方案；后续接入深色时，此处拆分为 Theme.Light.xaml /
         Theme.Dark.xaml 并用 ThemeDictionaries 承载，键名保持不变。
         下方 7 组 Sticky.* 便签色属于内容色（用户自选贴纸颜色），与界面语义色
         是正交维度，不参与 M3 映射。
         ========================================================================= -->

    <!-- 主色 -->
    <SolidColorBrush x:Key="Fluent.AccentBrush" Color="#3B608F" />
    <SolidColorBrush x:Key="Fluent.AccentHoverBrush" Color="#2D79CB" />
    <SolidColorBrush x:Key="Fluent.AccentPressedBrush" Color="#004784" />
    <SolidColorBrush x:Key="Fluent.AccentLightBgBrush" Color="#D4E3FF" />
    <SolidColorBrush x:Key="Fluent.AccentLightBorderBrush" Color="#214876" />

    <!-- 危险操作 -->
    <SolidColorBrush x:Key="Fluent.DangerBrush" Color="#BA1A1A" />
    <SolidColorBrush x:Key="Fluent.DangerHoverBrush" Color="#93000A" />
    <SolidColorBrush x:Key="Fluent.DangerLightBgBrush" Color="#FFDAD6" />

    <!-- 文本层级 -->
    <SolidColorBrush x:Key="Fluent.TextPrimaryBrush" Color="#191C20" />
    <SolidColorBrush x:Key="Fluent.TextSecondaryBrush" Color="#43474E" />
    <SolidColorBrush x:Key="Fluent.TextTertiaryBrush" Color="#73777F" />

    <!-- 描边：M3 全程使用不透明色。原 #1E000000 / #26000000 半透明黑
         在深色背景上等同隐形，接入深色主题前必须换掉。 -->
    <SolidColorBrush x:Key="Fluent.SubtleBorderBrush" Color="#C3C6CF" />
    <SolidColorBrush x:Key="Fluent.ControlBorderBrush" Color="#C3C6CF" />

    <!-- 表面层级 -->
    <SolidColorBrush x:Key="Fluent.CardDefaultBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Fluent.CardBgBrush" Color="#F2F3FA" />
    <SolidColorBrush x:Key="Fluent.WindowBgBrush" Color="#F9F9FF" />

    <!-- 1. 经典黄 Yellow -->
    <Color x:Key="Sticky.Yellow.BgColor">#FFF7D1</Color>
    <Color x:Key="Sticky.Yellow.ToolbarColor">#FFEE9D</Color>
    <SolidColorBrush x:Key="Sticky.Yellow.BgBrush" Color="#FFF7D1" />
    <SolidColorBrush x:Key="Sticky.Yellow.ToolbarBrush" Color="#FFEE9D" />
    <SolidColorBrush x:Key="Sticky.Yellow.BorderBrush" Color="#E6D77D" />
    <SolidColorBrush x:Key="Sticky.Yellow.AccentBrush" Color="#E0A800" />
    <SolidColorBrush x:Key="Sticky.Yellow.TextBrush" Color="#202020" />
    <SolidColorBrush x:Key="Sticky.Yellow.SecondaryTextBrush" Color="#6C6546" />

    <!-- 2. 清新绿 Green -->
    <Color x:Key="Sticky.Green.BgColor">#E4F9E0</Color>
    <Color x:Key="Sticky.Green.ToolbarColor">#C8F2C2</Color>
    <SolidColorBrush x:Key="Sticky.Green.BgBrush" Color="#E4F9E0" />
    <SolidColorBrush x:Key="Sticky.Green.ToolbarBrush" Color="#C8F2C2" />
    <SolidColorBrush x:Key="Sticky.Green.BorderBrush" Color="#BCE5B6" />
    <SolidColorBrush x:Key="Sticky.Green.AccentBrush" Color="#209E35" />
    <SolidColorBrush x:Key="Sticky.Green.TextBrush" Color="#202020" />
    <SolidColorBrush x:Key="Sticky.Green.SecondaryTextBrush" Color="#476A42" />

    <!-- 3. 柔和粉 Pink -->
    <Color x:Key="Sticky.Pink.BgColor">#FFE4EF</Color>
    <Color x:Key="Sticky.Pink.ToolbarColor">#FFC7DE</Color>
    <SolidColorBrush x:Key="Sticky.Pink.BgBrush" Color="#FFE4EF" />
    <SolidColorBrush x:Key="Sticky.Pink.ToolbarBrush" Color="#FFC7DE" />
    <SolidColorBrush x:Key="Sticky.Pink.BorderBrush" Color="#F5BCCE" />
    <SolidColorBrush x:Key="Sticky.Pink.AccentBrush" Color="#DB3374" />
    <SolidColorBrush x:Key="Sticky.Pink.TextBrush" Color="#202020" />
    <SolidColorBrush x:Key="Sticky.Pink.SecondaryTextBrush" Color="#774457" />

    <!-- 4. 梦幻紫 Purple -->
    <Color x:Key="Sticky.Purple.BgColor">#F2E6FF</Color>
    <Color x:Key="Sticky.Purple.ToolbarColor">#E4CCFF</Color>
    <SolidColorBrush x:Key="Sticky.Purple.BgBrush" Color="#F2E6FF" />
    <SolidColorBrush x:Key="Sticky.Purple.ToolbarBrush" Color="#E4CCFF" />
    <SolidColorBrush x:Key="Sticky.Purple.BorderBrush" Color="#D5BAFA" />
    <SolidColorBrush x:Key="Sticky.Purple.AccentBrush" Color="#7F3CD8" />
    <SolidColorBrush x:Key="Sticky.Purple.TextBrush" Color="#202020" />
    <SolidColorBrush x:Key="Sticky.Purple.SecondaryTextBrush" Color="#594575" />

    <!-- 5. 天空蓝 Blue -->
    <Color x:Key="Sticky.Blue.BgColor">#E1F3FE</Color>
    <Color x:Key="Sticky.Blue.ToolbarColor">#C3E8FD</Color>
    <SolidColorBrush x:Key="Sticky.Blue.BgBrush" Color="#E1F3FE" />
    <SolidColorBrush x:Key="Sticky.Blue.ToolbarBrush" Color="#C3E8FD" />
    <SolidColorBrush x:Key="Sticky.Blue.BorderBrush" Color="#B7DAF5" />
    <SolidColorBrush x:Key="Sticky.Blue.AccentBrush" Color="#1079D1" />
    <SolidColorBrush x:Key="Sticky.Blue.TextBrush" Color="#202020" />
    <SolidColorBrush x:Key="Sticky.Blue.SecondaryTextBrush" Color="#425C70" />

    <!-- 6. 浅灰白 Gray -->
    <Color x:Key="Sticky.Gray.BgColor">#F6F6F8</Color>
    <Color x:Key="Sticky.Gray.ToolbarColor">#E8E8EB</Color>
    <SolidColorBrush x:Key="Sticky.Gray.BgBrush" Color="#F6F6F8" />
    <SolidColorBrush x:Key="Sticky.Gray.ToolbarBrush" Color="#E8E8EB" />
    <SolidColorBrush x:Key="Sticky.Gray.BorderBrush" Color="#DCDCE0" />
    <SolidColorBrush x:Key="Sticky.Gray.AccentBrush" Color="#636366" />
    <SolidColorBrush x:Key="Sticky.Gray.TextBrush" Color="#202020" />
    <SolidColorBrush x:Key="Sticky.Gray.SecondaryTextBrush" Color="#616166" />

    <!-- 7. 暗黑夜间 Charcoal -->
    <Color x:Key="Sticky.Charcoal.BgColor">#292929</Color>
    <Color x:Key="Sticky.Charcoal.ToolbarColor">#1E1E1E</Color>
    <SolidColorBrush x:Key="Sticky.Charcoal.BgBrush" Color="#292929" />
    <SolidColorBrush x:Key="Sticky.Charcoal.ToolbarBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Sticky.Charcoal.BorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="Sticky.Charcoal.AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="Sticky.Charcoal.TextBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Sticky.Charcoal.SecondaryTextBrush" Color="#A6A6A6" />

</ResourceDictionary>

