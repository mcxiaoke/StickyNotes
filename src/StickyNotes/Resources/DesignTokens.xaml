<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:StickyNotes.Converters"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="StickyColors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ========================================================================= -->
    <!-- 1. 全局转换器注册                                                           -->
    <!-- ========================================================================= -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    <converters:FriendlyDateTimeConverter x:Key="FriendlyDateTimeConverter" />
    <converters:NoteColorToBackgroundBrushConverter x:Key="NoteColorToBgConverter" />
    <converters:NoteColorToToolbarBrushConverter x:Key="NoteColorToToolbarConverter" />
    <converters:NoteColorToTextBrushConverter x:Key="NoteColorToTextConverter" />
    <converters:NoteColorToBorderBrushConverter x:Key="NoteColorToBorderConverter" />
    <converters:NoteColorToAccentBrushConverter x:Key="NoteColorToAccentConverter" />
    <converters:NoteColorToSecondaryTextBrushConverter x:Key="NoteColorToSecondaryTextConverter" />
    <converters:NoteColorEqualsConverter x:Key="NoteColorEqualsConverter" />

    <!-- ========================================================================= -->
    <!-- 2. 统一设计间距规范（Spacing Tokens）                                      -->
    <!-- ========================================================================= -->
    <Thickness x:Key="Spacing.None">0</Thickness>
    <Thickness x:Key="Spacing.XXS">2</Thickness>
    <Thickness x:Key="Spacing.XS">4</Thickness>
    <Thickness x:Key="Spacing.S">8</Thickness>
    <Thickness x:Key="Spacing.M">12</Thickness>
    <Thickness x:Key="Spacing.L">16</Thickness>
    <Thickness x:Key="Spacing.XL">20</Thickness>
    <Thickness x:Key="Spacing.XXL">24</Thickness>

    <!-- 复合内/外边距规范 -->
    <Thickness x:Key="Thickness.PageMargin">16,14,16,16</Thickness>
    <Thickness x:Key="Thickness.HeaderMargin">0,0,0,12</Thickness>
    <Thickness x:Key="Thickness.CardPadding">14,12,14,12</Thickness>
    <Thickness x:Key="Thickness.SearchHitPadding">14,12,14,12</Thickness>
    <Thickness x:Key="Thickness.ChipPadding">12,5,12,5</Thickness>
    <Thickness x:Key="Thickness.StickyEditorPadding">16,10,16,8</Thickness>
    <Thickness x:Key="Thickness.StickyFooterMargin">16,0,16,4</Thickness>

    <!-- ========================================================================= -->
    <!-- 3. 统一控件圆角规范（CornerRadius Tokens）                                  -->
    <!-- ========================================================================= -->
    <CornerRadius x:Key="CornerRadius.Small">4</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Control">6</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Card">8</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Window">10</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Large">12</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Pill">999</CornerRadius>

    <!-- ========================================================================= -->
    <!-- 4. 阴影体系规范（Elevation & DropShadow Tokens）                           -->
    <!-- ========================================================================= -->
    <DropShadowEffect x:Key="Elevation.Card" BlurRadius="6" ShadowDepth="1" Opacity="0.04" Direction="270" />
    <DropShadowEffect x:Key="Elevation.CardHover" BlurRadius="10" ShadowDepth="2" Opacity="0.08" Direction="270" />
    <DropShadowEffect x:Key="Elevation.Popup" BlurRadius="14" ShadowDepth="3" Opacity="0.12" Direction="270" />
    <DropShadowEffect x:Key="Elevation.Window" BlurRadius="12" ShadowDepth="2" Opacity="0.14" Direction="270" />

    <!-- 供 Style / ControlTemplate Trigger 引用的固定效果实例（原 F-P2-22）。
         禁止在 Trigger 内联 new DropShadowEffect：那样每次 hover/选中都会换一个 Effect 实例，
         而 WPF 的 Effect 会强制该元素走**软件渲染**，列表滚动 + 鼠标划过时 CPU 飙升。
         统一引用此处的固定单例，既保留观感又去掉每次重建效果对象的开销。 -->
    <DropShadowEffect x:Key="Elevation.CardSubtle" BlurRadius="4" ShadowDepth="1" Opacity="0.05" Direction="270" />
    <DropShadowEffect x:Key="Elevation.CardHoverLight" BlurRadius="8" ShadowDepth="1.5" Opacity="0.10" Direction="270" />
    <DropShadowEffect x:Key="Elevation.CardFocus" BlurRadius="10" ShadowDepth="2" Opacity="0.16" Direction="270" Color="#0067C0" />
    <DropShadowEffect x:Key="Elevation.TabSelected" BlurRadius="4" ShadowDepth="1" Opacity="0.06" Direction="270" />

    <!-- ========================================================================= -->
    <!-- 5. 字体与排版体系（Typography Tokens）                                      -->
    <!-- ========================================================================= -->
    <FontFamily x:Key="FontFamily.Default">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>

    <!-- 窗口主标题 (Page Title - 优雅清秀大号标题，采用 Normal 字重规避假粗体) -->
    <Style x:Key="Type.TitleLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Fluent.TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 分组标题 (Section Header - 13.5px 正常字重，配合层次留白) -->
    <Style x:Key="Type.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Fluent.TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 设置项标题 (规范常规字重 13.5px Normal，杜绝粗黑) -->
    <Style x:Key="Type.SettingTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Fluent.TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 强调正文 (仅用于极少特定重点标签) -->
    <Style x:Key="Type.BodyStrong" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Fluent.TextPrimaryBrush}" />
    </Style>

    <!-- 普通正文 -->
    <Style x:Key="Type.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Fluent.TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 辅助/说明字 (自然呼吸感，优雅浅灰) -->
    <Style x:Key="Type.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Fluent.TextSecondaryBrush}" />
    </Style>

    <!-- 微型次级说明/标签字（默认允许换行：说明类文案多为整句，避免容器偏窄时被硬截断且无省略号） -->
    <Style x:Key="Type.CaptionSubtle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource Fluent.TextSecondaryBrush}" />
    </Style>

    <!-- ========================================================================= -->
    <!-- 6. 控件交互样式规范                                                         -->
    <!-- ========================================================================= -->

    <!-- Windows 11 现代分段选择标签 (Segmented Tab Style) -->
    <Style x:Key="FilterChipStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Fluent.TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadius.Control}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="#0C000000" />
                            <Setter Property="Foreground" Value="{StaticResource Fluent.TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#22000000" />
                            <!-- 引用固定效果单例，禁止在 Trigger 内联 DropShadowEffect（原 F-P2-22） -->
                            <Setter TargetName="TabBorder" Property="Effect" Value="{StaticResource Elevation.TabSelected}" />
                            <Setter Property="Foreground" Value="{StaticResource Fluent.TextPrimaryBrush}" />
                        </Trigger>
                        <!-- 键盘焦点指示（F-P1-11 剩余项）：1px 强调色描边；
                             置于 IsChecked 之后，焦点态的强调色描边优先于选中态的淡色描边 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Fluent.AccentBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 专属无底色纯净多行编辑器样式：融入便签贴纸底色 -->
    <Style x:Key="StickyEditorTextBoxStyle" TargetType="{x:Type TextBox}">
        <!-- 不再设置 KeyboardNavigation.TabNavigation=None：那会把编辑器从 Tab 链中整体剔除，
             键盘用户永远无法用 Tab 进入正文（F-P1-11 剩余项）。
             编辑器内部 Tab 仍插入制表符（AcceptsTab="True"），离开通道见 NoteWindow 的 Esc/Ctrl+Tab。 -->
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Auto" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 便签顶部微型操作按钮样式：悬停浅暗、微圆角平滑过渡 -->
    <Style x:Key="StickyToolbarButtonStyle" TargetType="Button">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerRadius.Small}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A000000" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#30000000" />
                        </Trigger>
                        <!-- 键盘焦点指示（F-P1-11 剩余项）：FocusVisualStyle 被置空后，
                             键盘用户必须仍有可见的焦点反馈 —— 1px 强调色描边 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fluent.AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 便签关闭按钮专属样式：悬停呈现微软标准红底白字 -->
    <Style x:Key="StickyCloseButtonStyle" TargetType="Button">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerRadius.Small}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fluent.DangerHoverBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fluent.DangerBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <!-- 键盘焦点指示（F-P1-11 剩余项）：1px 强调色描边 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fluent.AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 便签 Flyout 菜单条目样式 (标准 Windows 11 菜单项体验：整行 Hover 高亮，左右内容对齐) -->
    <Style x:Key="FluentFlyoutMenuItemStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerRadius.Small}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0F000000" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1C000000" />
                        </Trigger>
                        <!-- 键盘焦点指示（F-P1-11 剩余项）：1px 强调色描边 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fluent.AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 便签 Flyout 危险操作菜单条目样式 (归档/删除) -->
    <Style x:Key="FluentFlyoutDangerMenuItemStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerRadius.Small}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14C42B1C" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#24C42B1C" />
                        </Trigger>
                        <!-- 键盘焦点指示（F-P1-11 剩余项）：1px 强调色描边 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fluent.AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

