<Window x:Class="StickyNotes.Views.NotesListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:StickyNotes.Models"
        Title="便签管理中心"
        Width="440" Height="640"
        MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F9F9FB">

    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <!-- 顶部标题与新建栏 -->
            <RowDefinition Height="Auto" />
            <!-- 全宽搜索栏 -->
            <RowDefinition Height="Auto" />
            <!-- 状态或检索提示条 -->
            <RowDefinition Height="Auto" />
            <!-- 便签列表或搜索结果主体 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. 顶部标题与操作栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 品牌标题 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Note24" FontSize="22" Foreground="#0078D4" Margin="0,0,8,0" />
                <TextBlock Text="便签"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#1F1F1F"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 新建便签按钮 -->
            <ui:Button Grid.Column="1"
                       Appearance="Primary"
                       Icon="Add24"
                       Content="新建便签"
                       FontWeight="SemiBold"
                       Padding="14,6"
                       ToolTip="新建一张便签 (Ctrl+N)"
                       Command="{Binding NewNoteCommand}" />
        </Grid>

        <!-- 2. 全宽搜索框 -->
        <ui:TextBox x:Name="SearchBox"
                    Grid.Row="1"
                    PlaceholderText="搜索便签文字或内容... (Ctrl+F)"
                    Icon="Search24"
                    ClearButtonEnabled="True"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="14"
                    KeyDown="SearchBox_KeyDown" />

        <!-- 3. 状态/检索提示信息条 -->
        <Grid Grid.Row="2" Margin="2,10,2,10">
            <!-- 普通状态：便签总数与操作指引 -->
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="#777777"
                       Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Run Text="共 " /><Run Text="{Binding Notes.Count, Mode=OneWay}" /><Run Text=" 条便签 · 双击卡片在桌面打开" />
            </TextBlock>

            <!-- 搜索中状态：命中数提示 -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="0,0,6,0" Foreground="#0078D4" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="#0078D4"
                           FontWeight="Medium">
                    <Run Text="找到 " /><Run Text="{Binding SearchHitCount, Mode=OneWay}" /><Run Text=" 处匹配内容 (点击直达命中行)" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- 4. 主内容区 -->
        <Grid Grid.Row="3">
            <!-- 4.1 普通模式：真实彩色便签卡片流 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Note}">
                                <!-- 真实便签卡片容器：呈现便签对应原色底色与圆角阴影 -->
                                <Border Margin="0,0,0,12"
                                        CornerRadius="8"
                                        Background="{Binding Color, Converter={StaticResource NoteColorToBgConverter}}"
                                        BorderBrush="#18000000"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="NoteCard_MouseLeftButtonDown">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Direction="270" />
                                    </Border.Effect>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="打开便签" Click="ContextOpenNote_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Open20" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="切换置顶" Click="ContextTogglePin_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Pin20" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="删除便签" Click="ContextDeleteNote_Click" Foreground="#D83B01">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Delete20" FontSize="16" Foreground="#D83B01" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- 迷你便签工具条 -->
                                            <RowDefinition Height="24" />
                                            <!-- 便签内容摘要 -->
                                            <RowDefinition Height="*" />
                                            <!-- 底部时间栏 -->
                                            <RowDefinition Height="24" />
                                        </Grid.RowDefinitions>

                                        <!-- 迷你顶部色带 -->
                                        <Border Grid.Row="0"
                                                CornerRadius="7,7,0,0"
                                                Background="{Binding Color, Converter={StaticResource NoteColorToToolbarConverter}}">
                                            <Grid Margin="10,0,6,0">
                                                <TextBlock Text="" VerticalAlignment="Center" />
                                                <!-- 右侧：图钉 + 悬浮更多操作按钮 -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Pin20" FontSize="13"
                                                                   Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <Button Style="{StaticResource StickyToolbarButtonStyle}"
                                                            Padding="4,1"
                                                            ToolTip="便签操作"
                                                            Click="CardMoreButton_Click">
                                                        <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="13"
                                                                       Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 便签标题与两行摘要 -->
                                        <StackPanel Grid.Row="1" Margin="14,10,14,6">
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Text="{Binding Snippet}"
                                                       FontSize="13"
                                                       Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                                                       Opacity="0.75"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="36"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- 底部时间 -->
                                        <Grid Grid.Row="2" Margin="14,0,14,6">
                                            <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource FriendlyDateTimeConverter}}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                                                       Opacity="0.5"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态引导视图：没有任何便签时呈现 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,80,0,0"
                                Visibility="{Binding HasNoNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="Note24" FontSize="48" Foreground="#CCCCCC" Margin="0,0,0,12" />
                        <TextBlock Text="桌面还没有便签"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="点击右上角“新建便签”随时记录你的灵感与待办"
                                   FontSize="13"
                                   Foreground="#AAAAAA"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 3.2 搜索模式：命中列表与精准跳行导航 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SearchHit}">
                                <Border Margin="0,0,0,10"
                                        CornerRadius="8"
                                        Background="#FFFFFF"
                                        BorderBrush="#E5E5E5"
                                        BorderThickness="1"
                                        Padding="14,12"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="SearchHitCard_MouseLeftButtonDown">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.06" Direction="270" />
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 便签标题 + 命中行号徽标 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 标题与所属颜色小圆点 -->
                                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                <Border Width="12" Height="12" CornerRadius="6"
                                                        Background="{Binding Color, Converter={StaticResource NoteColorToToolbarConverter}}"
                                                        BorderBrush="#25000000"
                                                        BorderThickness="1"
                                                        Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding NoteTitle}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1C1C1C"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- 第 N 行 高亮小徽标 -->
                                            <Border Grid.Column="1"
                                                    Background="#EBF3FC"
                                                    BorderBrush="#CCE4F7"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,3">
                                                <TextBlock FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="#0078D4">
                                                    <Run Text="第 " /><Run Text="{Binding LineNumber}" /><Run Text=" 行" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>

                                        <!-- 所在行上下文摘要（浅底色微框） -->
                                        <Border Grid.Row="1"
                                                Background="#F8F9FA"
                                                CornerRadius="5"
                                                Padding="10,8"
                                                Margin="0,8,0,0">
                                            <TextBlock Text="{Binding LineSnippet}"
                                                       FontSize="13"
                                                       Foreground="#444444"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 搜索无结果空状态 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,80,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchHitCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:SymbolIcon Symbol="Search24" FontSize="44" Foreground="#D0D0D0" Margin="0,0,0,10" />
                        <TextBlock Text="未找到匹配的便签"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="请尝试更换关键字或检查拼写"
                                   FontSize="13"
                                   Foreground="#AAAAAA"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
