<ui:FluentWindow x:Class="StickyNotes.Views.NotesListWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:models="clr-namespace:StickyNotes.Models"
                 Title="彩色便签"
                 Icon="pack://application:,,,/StickyNotes;component/Assets/AppIcon.ico"
                 Width="480" Height="720"
                 MinWidth="380" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{StaticResource Fluent.WindowBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Fluent 现代沉浸式标题栏 -->
            <RowDefinition Height="Auto" />
            <!-- 1: 主内容容器 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. Fluent 标题栏 -->
        <ui:TitleBar Grid.Row="0"
                     Title="彩色便签"
                     Icon="pack://application:,,,/StickyNotes;component/Assets/AppIcon.ico"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <!-- 1. 主内容区 -->
        <Grid Grid.Row="1" Margin="{StaticResource Thickness.PageMargin}">
            <Grid.RowDefinitions>
                <!-- 顶部主标题与新建操作栏 -->
                <RowDefinition Height="Auto" />
                <!-- 现代全宽搜索栏 -->
                <RowDefinition Height="Auto" />
                <!-- 分类筛选胶囊与状态提示条 -->
                <RowDefinition Height="Auto" />
                <!-- 便签卡片流或搜索结果展示区 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1.1 顶部标题与新建操作栏 -->
            <Grid Grid.Row="0" Margin="{StaticResource Thickness.HeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧品牌与标题 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/StickyNotes;component/Assets/AppIcon.png"
                           Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="便签"
                               Style="{StaticResource Type.TitleLarge}" />
                </StackPanel>

                <!-- 右侧操作群：已归档、设置、新建（高度统一 32px） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 已归档入口按钮 -->
                    <ui:Button Appearance="Secondary"
                               Content="已归档"
                               Height="32"
                               Padding="10,0"
                               ToolTip="查看已归档便签"
                               Margin="0,0,6,0"
                               Click="OpenArchiveButton_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Archive24" FontSize="15" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <!-- 设置入口按钮 -->
                    <ui:Button Appearance="Secondary"
                               Content="设置"
                               Height="32"
                               Padding="10,0"
                               ToolTip="设置"
                               Margin="0,0,6,0"
                               Click="OpenSettingsButton_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Settings24" FontSize="15" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <!-- 新建便签按钮 (Windows 11 Accent 胶囊) -->
                    <ui:Button Appearance="Primary"
                               Content="新建"
                               FontWeight="SemiBold"
                               Height="32"
                               Padding="12,0"
                               ToolTip="新建一张便签 (Ctrl+N)"
                               Command="{Binding NewNoteCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" FontSize="15" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>



            <!-- 1.2 现代 Fluent 搜索栏 -->
            <ui:TextBox x:Name="SearchBox"
                        Grid.Row="1"
                        PlaceholderText="搜索便签内容... (Ctrl+F)"
                        ClearButtonEnabled="True"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="13"
                        Margin="0,0,0,10"
                        KeyDown="SearchBox_KeyDown">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <!-- 1.3 分类筛选与状态信息栏 -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <!-- 非搜索状态：显示分类胶囊 Filter Chips 与右侧提示 -->
                <Grid Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 分类筛选胶囊群 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="FilterAllRadio"
                                     Style="{StaticResource FilterChipStyle}"
                                     GroupName="NoteFilterGroup"
                                     IsChecked="True"
                                     Checked="FilterAllRadio_Checked">
                            <TextBlock>
                                <Run Text="全部" />
                                <Run Text=" (" /><Run Text="{Binding Notes.Count, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </RadioButton>

                        <RadioButton x:Name="FilterPinnedRadio"
                                     Style="{StaticResource FilterChipStyle}"
                                     GroupName="NoteFilterGroup"
                                     Margin="6,0,0,0"
                                     Checked="FilterPinnedRadio_Checked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Pin16" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="已置顶" />
                                    <Run Text=" (" /><Run Text="{Binding PinnedNotesCount, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 右侧辅助提示 -->
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource Type.CaptionSubtle}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="双击卡片打开" />
                </Grid>

                <!-- 搜索状态：显示命中统计提示 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="0,0,6,0" Foreground="{StaticResource Fluent.AccentBrush}" />
                    <TextBlock Style="{StaticResource Type.Caption}"
                               Foreground="{StaticResource Fluent.AccentBrush}"
                               FontWeight="SemiBold">
                        <Run Text="找到 " /><Run Text="{Binding SearchHitCount, Mode=OneWay}" /><Run Text=" 处匹配内容 (回车或点击直达)" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- 1.4 主卡片流列表 -->
            <Grid Grid.Row="3">
                <!-- 普通列表模式：一体化通体原色 Fluent 便签卡片流 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding FilteredNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Note}">
                                    <!-- 一体化高雅卡片：通体原色融合，自适应 1~4 行纯文本，支持悬浮上浮效果 -->
                                    <Border Margin="0,0,0,10"
                                            CornerRadius="{StaticResource CornerRadius.Card}"
                                            Background="{Binding Color, Converter={StaticResource NoteColorToBgConverter}}"
                                            BorderBrush="{Binding Color, Converter={StaticResource NoteColorToBorderConverter}}"
                                            BorderThickness="1"
                                            Padding="{StaticResource Thickness.CardPadding}"
                                            MouseLeftButtonDown="NoteCard_MouseLeftButtonDown">
                                        <!-- 鼠标滑过微悬浮与立体阴影动效 -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.08" Direction="270" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <TranslateTransform Y="0" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" Direction="270" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <TranslateTransform Y="-1.5" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="打开便签" Click="ContextOpenNote_Click">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Open20" FontSize="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="切换列表置顶" Click="ContextTogglePin_Click">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Pin20" FontSize="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="归档便签" Click="ContextDeleteNote_Click" Foreground="{StaticResource Fluent.DangerBrush}">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Archive20" FontSize="16" Foreground="{StaticResource Fluent.DangerBrush}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- 左侧精致原色药丸条 (Accent Bar) -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- 核心内容区 -->
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 左侧纵向色彩标识条 -->
                                            <Border Grid.Column="0"
                                                    Width="4"
                                                    CornerRadius="{StaticResource CornerRadius.Pill}"
                                                    Background="{Binding Color, Converter={StaticResource NoteColorToAccentConverter}}"
                                                    Margin="0,2,10,2" />

                                            <!-- 右侧卡片内容区 -->
                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <!-- 纯文本内容与操作栏 -->
                                                    <RowDefinition Height="*" />
                                                    <!-- 底部信息 -->
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 上部：纯文本（统一字体不加粗，自适应 1~4 行）与右上角操作区 -->
                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 纯文本正文：按需显示，最小一行，最多4行 -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding PreviewText}"
                                                               Style="{StaticResource Type.Body}"
                                                               FontWeight="Normal"
                                                               FontSize="13"
                                                               Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               LineHeight="20"
                                                               MaxHeight="80"
                                                               VerticalAlignment="Top"
                                                               Margin="0,2,8,0" />

                                                    <!-- 右侧图钉与更多操作 -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <ui:SymbolIcon Symbol="Pin20"
                                                                       FontSize="13"
                                                                       Margin="0,3,4,0"
                                                                       VerticalAlignment="Top"
                                                                       Foreground="{Binding Color, Converter={StaticResource NoteColorToAccentConverter}}"
                                                                       Visibility="{Binding IsPinnedInList, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <Button Style="{StaticResource StickyToolbarButtonStyle}"
                                                                ToolTip="便签操作"
                                                                Click="CardMoreButton_Click">
                                                            <ui:SymbolIcon Symbol="MoreHorizontal20"
                                                                           FontSize="14"
                                                                           Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 底部时间戳与状态信息 -->
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 字符统计微标签 -->
                                                    <TextBlock Grid.Column="0"
                                                               Style="{StaticResource Type.CaptionSubtle}"
                                                               Foreground="{Binding Color, Converter={StaticResource NoteColorToSecondaryTextConverter}}"
                                                               VerticalAlignment="Center">
                                                        <Run Text="{Binding Content.Length, Mode=OneWay}" /><Run Text=" 字符" />
                                                    </TextBlock>

                                                    <!-- 友好更新时间 -->
                                                    <TextBlock Grid.Column="1"
                                                               Style="{StaticResource Type.CaptionSubtle}"
                                                               Foreground="{Binding Color, Converter={StaticResource NoteColorToSecondaryTextConverter}}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding UpdatedAt, Converter={StaticResource FriendlyDateTimeConverter}}" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                        <!-- 空状态引导视图 -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,80,0,0"
                                    Visibility="{Binding HasNoNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="Note24" FontSize="48" Foreground="{StaticResource Fluent.TextTertiaryBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="还没有任何便签"
                                       Style="{StaticResource Type.Subtitle}"
                                       Foreground="{StaticResource Fluent.TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="点击上方“新建便签”随时记录你的灵感与任务"
                                       Style="{StaticResource Type.Caption}"
                                       Foreground="{StaticResource Fluent.TextTertiaryBrush}"
                                       Margin="0,6,0,16"
                                       HorizontalAlignment="Center" />
                            <ui:Button Appearance="Secondary"
                                       Icon="Add24"
                                       Content="立即创建第一张便签"
                                       HorizontalAlignment="Center"
                                       Command="{Binding NewNoteCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 搜索模式视图：精准跳行与清晰命中 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SearchHit}">
                                    <Border Margin="0,0,0,10"
                                            CornerRadius="{StaticResource CornerRadius.Card}"
                                            Background="{StaticResource Fluent.CardDefaultBgBrush}"
                                            BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                                            BorderThickness="1"
                                            Padding="{StaticResource Thickness.SearchHitPadding}"
                                            Effect="{StaticResource Elevation.Card}"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="SearchHitCard_MouseLeftButtonDown">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 便签所属色标、标题与第 N 行指示器 -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                    <!-- 对应便签原色圆点 -->
                                                    <Border Width="10" Height="10"
                                                            CornerRadius="5"
                                                            Background="{Binding Color, Converter={StaticResource NoteColorToAccentConverter}}"
                                                            Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding NoteTitle}"
                                                               Style="{StaticResource Type.Subtitle}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- 现代 Accent 小胶囊 -->
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource Fluent.AccentLightBgBrush}"
                                                        BorderBrush="{StaticResource Fluent.AccentLightBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource CornerRadius.Small}"
                                                        Padding="8,2">
                                                    <TextBlock Style="{StaticResource Type.CaptionSubtle}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Fluent.AccentBrush}">
                                                        <Run Text="第 " /><Run Text="{Binding LineNumber}" /><Run Text=" 行" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <!-- 上下文行预览 -->
                                            <Border Grid.Row="1"
                                                    Background="{StaticResource Fluent.WindowBgBrush}"
                                                    CornerRadius="{StaticResource CornerRadius.Small}"
                                                    Padding="10,6"
                                                    Margin="0,8,0,0">
                                                <TextBlock Text="{Binding LineSnippet}"
                                                           Style="{StaticResource Type.Body}"
                                                           Foreground="{StaticResource Fluent.TextPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 搜索无结果提示 -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,80,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchHitCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Symbol="Search24" FontSize="44" Foreground="{StaticResource Fluent.TextTertiaryBrush}" Margin="0,0,0,10" />
                            <TextBlock Text="未找到匹配的便签"
                                       Style="{StaticResource Type.Subtitle}"
                                       Foreground="{StaticResource Fluent.TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="请尝试更换关键字或检查拼写"
                                       Style="{StaticResource Type.Caption}"
                                       Foreground="{StaticResource Fluent.TextTertiaryBrush}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>

