<Window x:Class="StickyNotes.Views.NotesListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:StickyNotes.Models"
        Title="便签管理中心"
        Width="440" Height="620"
        MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="{StaticResource Spacing.PageMargin}">
        <Grid.RowDefinitions>
            <!-- 顶部搜索与操作栏 -->
            <RowDefinition Height="Auto" />
            <!-- 状态或检索提示条 -->
            <RowDefinition Height="Auto" />
            <!-- 便签列表或搜索结果主体 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部操作栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 搜索框 -->
            <ui:TextBox Grid.Column="0"
                        PlaceholderText="搜索便签文字或内容..."
                        Icon="Search24"
                        ClearButtonEnabled="True"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,8,0" />

            <!-- 新建便签按钮 -->
            <ui:Button Grid.Column="1"
                       Appearance="Primary"
                       Icon="Add24"
                       Content="新建"
                       ToolTip="新建一张便签 (Ctrl+N)"
                       Command="{Binding NewNoteCommand}" />
        </Grid>

        <!-- 状态/检索提示信息 -->
        <Grid Grid.Row="1" Margin="0,10,0,8">
            <!-- 普通状态信息 -->
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Run Text="共 " /><Run Text="{Binding Notes.Count, Mode=OneWay}" /><Run Text=" 条便签（双击卡片可在桌面贴出）" />
            </TextBlock>

            <!-- 搜索中状态信息 -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="0,0,4,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                    <Run Text="找到 " /><Run Text="{Binding SearchHitCount, Mode=OneWay}" /><Run Text=" 处匹配内容（点击直接跳转至命中行）" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- 主内容区：使用条件显示切换卡片流与搜索结果 -->
        <Grid Grid.Row="2">
            <!-- 1. 普通模式：便签卡片流 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Note}">
                            <ui:CardAction Margin="0,0,0,8"
                                           Padding="12,10"
                                           Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- 便签颜色指引竖条 -->
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 颜色标签 -->
                                    <Border Grid.Column="0"
                                            CornerRadius="3"
                                            Background="{Binding Color, Converter={StaticResource NoteColorToBgConverter}}"
                                            BorderBrush="{Binding Color, Converter={StaticResource NoteColorToToolbarConverter}}"
                                            BorderThickness="1"
                                            Margin="0,2,8,2" />

                                    <!-- 标题与摘要 -->
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Snippet}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="36"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- 右侧置顶状态与修改时间 -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <ui:SymbolIcon Symbol="Pin20"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource FriendlyDateTimeConverter}}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </ui:CardAction>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 2. 搜索模式：命中行列表 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SearchHit}">
                            <ui:CardAction Margin="0,0,0,8"
                                           Padding="12,10"
                                           Command="{Binding DataContext.SelectSearchHitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 便签标题 + 命中行号徽标 -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <!-- 便签小色块 -->
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    Background="{Binding Color, Converter={StaticResource NoteColorToBgConverter}}"
                                                    BorderBrush="{Binding Color, Converter={StaticResource NoteColorToToolbarConverter}}"
                                                    BorderThickness="1"
                                                    Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding NoteTitle}"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- 行号徽标 -->
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                                <Run Text="第 " /><Run Text="{Binding LineNumber}" /><Run Text=" 行" />
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- 所在行文字上下文与高亮提示 -->
                                    <Border Grid.Row="1"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="0,6,0,0">
                                        <TextBlock Text="{Binding LineSnippet}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                            </ui:CardAction>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
