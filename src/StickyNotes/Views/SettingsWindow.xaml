<ui:FluentWindow x:Class="StickyNotes.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="设置"
                 Icon="pack://application:,,,/StickyNotes;component/Assets/AppIcon.ico"
                 Width="480" Height="680"
                 MinWidth="420" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{StaticResource Fluent.WindowBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Fluent 沉浸式标题栏 -->
            <RowDefinition Height="Auto" />
            <!-- 1: 主内容区 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. Fluent 标题栏 -->
        <ui:TitleBar Grid.Row="0"
                     Title="设置"
                     Icon="pack://application:,,,/StickyNotes;component/Assets/AppIcon.ico"
                     ShowMaximize="False"
                     ShowMinimize="True" />

        <!-- 1. 设置内容滚动区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource Thickness.PageMargin}">
                <!-- 顶部页面标题 (遵循 Windows 11 Fluent 设置规范) -->
                <TextBlock Text="设置"
                           Style="{StaticResource Type.TitleLarge}"
                           Margin="0,0,0,14" />

                <!-- 分组 1: 外观与字体 -->
                <TextBlock Text="外观与显示"
                           Style="{StaticResource Type.Subtitle}"
                           Margin="0,0,0,8" />

                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                        Background="{StaticResource Fluent.CardBgBrush}"
                        BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                        BorderThickness="1"
                        Padding="{StaticResource Thickness.CardPadding}"
                        Margin="0,0,0,14"
                        Effect="{StaticResource Elevation.Card}">
                    <StackPanel>
                        <!-- 字号调节行 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="便签正文字号"
                                           Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="调整桌面便签贴纸的正文字体大小，即时生效"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      Width="200"
                                      ItemsSource="{Binding FontSizeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Size"
                                      SelectedValue="{Binding SelectedFontSize, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 实时预览区 -->
                        <TextBlock Text="文字效果实时预览："
                                   Style="{StaticResource Type.CaptionSubtle}"
                                   Margin="0,0,0,6" />
                        <Border Background="{StaticResource Sticky.Yellow.BgBrush}"
                                BorderBrush="{StaticResource Sticky.Yellow.BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadius.Control}"
                                Padding="12,10">
                            <TextBlock Text="{Binding PreviewText}"
                                       FontSize="{Binding SelectedFontSize}"
                                       Foreground="{StaticResource Sticky.Yellow.TextBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 分组 2: 窗口与系统集成 (托盘、热键、开机自启) -->
                <TextBlock Text="系统与常驻"
                           Style="{StaticResource Type.Subtitle}"
                           Margin="0,4,0,8" />

                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                        Background="{StaticResource Fluent.CardBgBrush}"
                        BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                        BorderThickness="1"
                        Padding="{StaticResource Thickness.CardPadding}"
                        Margin="0,0,0,14"
                        Effect="{StaticResource Elevation.Card}">
                    <StackPanel>
                        <!-- 1. 关闭主窗口时最小化到系统托盘 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="关闭主窗口时最小化到系统托盘" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="关闭主列表窗口后在后台保持运行，贴纸继续可用，通过托盘图标可随时唤醒"
                                           Style="{StaticResource Type.CaptionSubtle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                                             VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 2. 全局快捷键 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="启用系统全局快捷键" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="Win+Alt+N：随时快速新建便签；Win+Alt+H：随时呼出便签管理中心"
                                           Style="{StaticResource Type.CaptionSubtle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding EnableGlobalHotKeys, Mode=TwoWay}"
                                             VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 3. Windows 开机自动启动 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="开机自动启动" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="计算机启动登录时自动启动 StickyNotes 并恢复桌面敞开贴纸"
                                           Style="{StaticResource Type.CaptionSubtle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding IsAutoStartEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 4. 开机自启时静默启动至托盘 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="开机启动时最小化到托盘" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="随系统自启时不弹出管理中心主窗口，仅恢复桌面贴纸并在托盘静默就绪"
                                           Style="{StaticResource Type.CaptionSubtle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                             IsEnabled="{Binding IsStartMinimizedEnabled}"
                                             VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分组 3: 数据备份与迁移 -->
                <TextBlock Text="数据与备份"
                           Style="{StaticResource Type.Subtitle}"
                           Margin="0,4,0,8" />

                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                        Background="{StaticResource Fluent.CardBgBrush}"
                        BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                        BorderThickness="1"
                        Padding="{StaticResource Thickness.CardPadding}"
                        Margin="0,0,0,14"
                        Effect="{StaticResource Elevation.Card}">
                    <StackPanel>
                        <TextBlock Text="JSON 备份导入与导出"
                                   Style="{StaticResource Type.SettingTitle}" />
                        <TextBlock Text="将所有便签备份为标准 JSON 文件，或从备份文件还原便签数据"
                                   Style="{StaticResource Type.CaptionSubtle}"
                                   Margin="0,3,0,12" />

                        <!-- 导出与导入按钮组 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button Appearance="Primary"
                                       Content="导出便签 (JSON)"
                                       Margin="0,0,10,0"
                                       Padding="14,6"
                                       Command="{Binding ExportJsonCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Appearance="Secondary"
                                       Content="导入便签 (JSON)"
                                       Padding="14,6"
                                       Command="{Binding ImportJsonCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowUpload24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 本地存储目录 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="本地数据目录"
                                               Style="{StaticResource Type.SettingTitle}" />
                                    <Border CornerRadius="4"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Margin="8,0,0,0"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeploymentModeDescription}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding DataDirectoryPath}"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="提示：在 exe 同目录下放置 portable.ini 即可开启便携绿化模式（数据保存在同级 app_data/ 目录）"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           Opacity="0.8" />
                            </StackPanel>

                            <ui:Button Grid.Column="1"
                                       Appearance="Secondary"
                                       Content="打开目录"
                                       Padding="12,4"
                                       Command="{Binding OpenDataFolderCommand}"
                                       VerticalAlignment="Center">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分组: 网络同步 -->
                <TextBlock Text="网络同步"
                           Style="{StaticResource Type.Subtitle}"
                           Margin="0,4,0,8" />

                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                        Background="{StaticResource Fluent.CardBgBrush}"
                        BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                        BorderThickness="1"
                        Padding="{StaticResource Thickness.CardPadding}"
                        Margin="0,0,0,14"
                        Effect="{StaticResource Elevation.Card}">
                    <StackPanel>
                        <!-- 1. 启用开关 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="启用网络同步" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="通过 WebDAV 或 Cloudflare R2 在多台设备间同步便签；同一便签按最新修改时间自动合并"
                                           Style="{StaticResource Type.CaptionSubtle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding SyncEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 2. 后端类型 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="存储后端" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="WebDAV 适用于坚果云/Nextcloud/Alist 等；R2 走 S3 兼容 API"
                                           Style="{StaticResource Type.CaptionSubtle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Width="210"
                                      ItemsSource="{Binding SyncBackendOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Type"
                                      SelectedValue="{Binding SelectedSyncBackendType, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <!-- 3. WebDAV 配置面板 -->
                        <StackPanel Visibility="{Binding IsWebDavPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="服务器地址（目录级 URL，如 https://dav.example.com/dav/StickyNotes/）"
                                       Style="{StaticResource Type.CaptionSubtle}" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding SyncWebDavUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="https://"
                                        Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="用户名" Style="{StaticResource Type.CaptionSubtle}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding SyncWebDavUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="密码 / 应用专用密码" Style="{StaticResource Type.CaptionSubtle}" Margin="0,0,0,4" />
                                    <PasswordBox x:Name="WebDavPasswordBox"
                                                 PasswordChanged="WebDavPasswordBox_OnPasswordChanged" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SyncWebDavCredentialHint}"
                                       Style="{StaticResource Type.CaptionSubtle}"
                                       FontSize="11" Margin="0,0,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="允许明文 HTTP（仅限内网 NAS）" Style="{StaticResource Type.SettingTitle}" />
                                    <TextBlock Text="默认强制 HTTPS；勾选后允许 http:// 地址，传输内容将不加密"
                                               Style="{StaticResource Type.CaptionSubtle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 IsChecked="{Binding SyncAllowInsecureHttp, Mode=TwoWay}"
                                                 VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- 4. S3 / Cloudflare R2 配置面板 -->
                        <StackPanel Visibility="{Binding IsS3PanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="S3 API 端点（R2 账户端点）" Style="{StaticResource Type.CaptionSubtle}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding SyncS3Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="https://&lt;account-id&gt;.r2.cloudflarestorage.com" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="桶名" Style="{StaticResource Type.CaptionSubtle}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding SyncS3Bucket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="对象前缀子目录（必填，与其他数据隔离）"
                                       Style="{StaticResource Type.CaptionSubtle}" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding SyncS3BasePrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="stickynotes/"
                                        Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="访问密钥 ID (Access Key)" Style="{StaticResource Type.CaptionSubtle}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding SyncS3AccessKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="秘密访问密钥 (Secret Key)" Style="{StaticResource Type.CaptionSubtle}" Margin="0,0,0,4" />
                                    <PasswordBox x:Name="S3SecretKeyBox"
                                                 PasswordChanged="S3SecretKeyBox_OnPasswordChanged" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SyncS3CredentialHint}"
                                       Style="{StaticResource Type.CaptionSubtle}"
                                       FontSize="11" />
                        </StackPanel>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,10,0,10" />

                        <!-- 5. 间隔与操作 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="后台同步间隔" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="便签新增/修改后 5 秒自动同步一次；此处为兜底轮询间隔"
                                           Style="{StaticResource Type.CaptionSubtle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Width="160"
                                      ItemsSource="{Binding SyncIntervalOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Minutes"
                                      SelectedValue="{Binding SelectedSyncIntervalMinutes, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:Button Appearance="Secondary"
                                       Content="测试连接"
                                       Padding="14,6"
                                       Margin="0,0,10,0"
                                       Command="{Binding TestSyncConnectionCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="PlugConnected24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Appearance="Primary"
                                       Content="立即同步"
                                       Padding="14,6"
                                       Command="{Binding SyncNowManualCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>

                        <TextBlock Text="{Binding SyncStatusText}"
                                   Style="{StaticResource Type.CaptionSubtle}"
                                   TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SyncDeviceId, StringFormat=设备标识：{0}}"
                                   Style="{StaticResource Type.CaptionSubtle}"
                                   FontSize="11" Opacity="0.8" />
                    </StackPanel>
                </Border>

                <!-- 分组: 隐私保护 (PIN 锁定 + 闲时自动收起) -->
                <TextBlock Text="隐私保护"
                           Style="{StaticResource Type.Subtitle}"
                           Margin="0,4,0,8" />

                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                        Background="{StaticResource Fluent.CardBgBrush}"
                        BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                        BorderThickness="1"
                        Padding="{StaticResource Thickness.CardPadding}"
                        Margin="0,0,0,14"
                        Effect="{StaticResource Elevation.Card}">
                    <StackPanel>
                        <!-- 1. PIN 锁定 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="PIN 锁定" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="{Binding PinStatusText}"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                                <!-- PIN 数据损坏告警：绝不允许「以为受保护实则未受保护」静默发生 -->
                                <TextBlock Text="⚠ 检测到 PIN 配置数据缺失或已损坏，锁定已失效。请重新启用并设置 PIN。"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           Foreground="{StaticResource Fluent.DangerBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding IsPinDataCorrupted, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 未启用：显示启用按钮 -->
                                <ui:Button Appearance="Primary"
                                           Content="启用 PIN"
                                           Padding="12,5"
                                           Command="{Binding EnablePinCommand}"
                                           Visibility="{Binding IsPinEnabled, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                <!-- 已启用：显示修改与清除按钮 -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsPinEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ui:Button Appearance="Secondary"
                                               Content="修改 PIN"
                                               Padding="12,5"
                                               Margin="0,0,8,0"
                                               Command="{Binding ChangePinCommand}" />
                                    <ui:Button Appearance="Secondary"
                                               Content="清除 PIN"
                                               Padding="12,5"
                                               Foreground="{StaticResource Fluent.DangerBrush}"
                                               Command="{Binding ClearPinCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 2. 列表窗口闲时自动收起 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="列表窗口不在前台时自动关闭" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="管理中心窗口持续不在前台达到设定时间后自动收起，再次打开时需输入 PIN（若已启用）"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      Width="150"
                                      ItemsSource="{Binding AutoCloseOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Minutes"
                                      SelectedValue="{Binding SelectedAutoCloseMinutes, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分组 3: 关于与版本 -->
                <TextBlock Text="关于"
                           Style="{StaticResource Type.Subtitle}"
                           Margin="0,4,0,8" />

                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                        Background="{StaticResource Fluent.CardBgBrush}"
                        BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                        BorderThickness="1"
                        Padding="{StaticResource Thickness.CardPadding}"
                        Margin="0,0,0,14"
                        Effect="{StaticResource Elevation.Card}">
                    <StackPanel>
                        <!-- 产品头部 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Image Source="pack://application:,,,/StickyNotes;component/Assets/AppIcon.png"
                                   Width="36" Height="36"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="StickyNotes 彩色便签"
                                           Style="{StaticResource Type.Subtitle}" />
                                <TextBlock Text="基于 Windows 11 Fluent 2 现代桌面便签应用"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 元数据列表 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="应用版本" Style="{StaticResource Type.CaptionSubtle}" />
                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource Type.Body}" FontWeight="SemiBold" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Git 提交" Style="{StaticResource Type.CaptionSubtle}" />
                            <TextBlock Grid.Column="1" Text="{Binding GitCommit}" Style="{StaticResource Type.Caption}" FontFamily="Consolas" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="构建时间" Style="{StaticResource Type.CaptionSubtle}" />
                            <TextBlock Grid.Column="1" Text="{Binding BuildTime}" Style="{StaticResource Type.Caption}" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="运行环境" Style="{StaticResource Type.CaptionSubtle}" />
                            <TextBlock Grid.Column="1" Text="{Binding RuntimeInfo}" Style="{StaticResource Type.Caption}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
