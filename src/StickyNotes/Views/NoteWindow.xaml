<Window x:Class="StickyNotes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:StickyNotes.Models"
        Title="{Binding Note.DisplayTitle}"
        Width="340" Height="380"
        MinWidth="260" MinHeight="220"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        Background="{Binding Color, Converter={StaticResource NoteColorToBgConverter}}"
        Topmost="{Binding IsPinned}">

    <Border BorderBrush="#22000000" BorderThickness="1">
        <Grid Background="{Binding Color, Converter={StaticResource NoteColorToBgConverter}}">
            <Grid.RowDefinitions>
                <!-- 顶部无缝工具栏 -->
                <RowDefinition Height="40" />
                <!-- 正文编辑区（占满剩余高度） -->
                <RowDefinition Height="*" />
                <!-- 底部微型辅助栏 -->
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- 1. 顶部工具栏：一体化原色微调，全区域支持按住拖拽 -->
            <Border Grid.Row="0"
                    Background="{Binding Color, Converter={StaticResource NoteColorToToolbarConverter}}"
                    MouseLeftButtonDown="Toolbar_MouseLeftButtonDown"
                    Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 左侧：新建按钮 -->
                        <ColumnDefinition Width="Auto" />
                        <!-- 中间：拖拽区域 -->
                        <ColumnDefinition Width="*" />
                        <!-- 右侧：置顶、更多菜单、关闭 -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 新建便签按钮 -->
                    <Button Grid.Column="0"
                            Style="{StaticResource StickyToolbarButtonStyle}"
                            ToolTip="新建便签 (Ctrl+N)"
                            Click="NewNoteButton_Click">
                        <ui:SymbolIcon Symbol="Add20" FontSize="16" Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}" />
                    </Button>

                    <!-- 中间拖拽标题占位（透明贯穿） -->
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False" />

                    <!-- 右侧按钮操作群 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 置顶图钉切换按钮 -->
                        <Button Style="{StaticResource StickyToolbarButtonStyle}"
                                ToolTip="置顶便签 (Ctrl+P)"
                                Command="{Binding TogglePinCommand}">
                            <Grid>
                                <Border x:Name="PinnedHighlight" Width="24" Height="24" CornerRadius="12"
                                        Background="#26000000"
                                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ui:SymbolIcon Symbol="Pin20" FontSize="16"
                                               Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}" />
                            </Grid>
                        </Button>

                        <!-- 微软 Sticky Notes 原汁原味的 ··· 更多菜单 -->
                        <Button x:Name="MoreMenuButton"
                                Style="{StaticResource StickyToolbarButtonStyle}"
                                ToolTip="便签设置与颜色"
                                Click="MoreMenuButton_Click">
                            <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="16"
                                           Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}" />
                        </Button>

                        <!-- 更多菜单弹出层：包含 7 种主题色彩圆点与操作项 -->
                        <Popup x:Name="MoreMenuPopup"
                               PlacementTarget="{Binding ElementName=MoreMenuButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                        <Border Background="#FFFFFFFF"
                                BorderBrush="#1F000000"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.16" Direction="270" />
                            </Border.Effect>

                            <StackPanel Width="210">
                                <!-- 顶部提示 -->
                                <TextBlock Text="便签主题色彩"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#888888"
                                           Margin="2,0,0,8" />

                                <!-- 7 色精美圆形调色盘 -->
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Yellow.BgBrush}" BorderBrush="#DDCC77" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Yellow}" ToolTip="经典黄" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Green.BgBrush}" BorderBrush="#99DDAA" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Green}" ToolTip="清新绿" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Pink.BgBrush}" BorderBrush="#EEAACC" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Pink}" ToolTip="柔和粉" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Purple.BgBrush}" BorderBrush="#CCBBDD" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Purple}" ToolTip="梦幻紫" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Blue.BgBrush}" BorderBrush="#99CCEE" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Blue}" ToolTip="天空蓝" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Gray.BgBrush}" BorderBrush="#CCCCCC" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Gray}" ToolTip="浅灰白" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Charcoal.BgBrush}" BorderBrush="#444444" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Charcoal}" ToolTip="暗黑夜间" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </WrapPanel>

                                <Separator Margin="0,10,0,6" Background="#1F000000" />

                                <!-- 快捷跳转：便签列表 -->
                                <ui:Button Appearance="Transparent"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Icon="AppsListDetail20"
                                           Content="便签管理中心 (Ctrl+H)"
                                           FontSize="13"
                                           Padding="8,6"
                                           Click="ShowNotesList_Click" />

                                <!-- 删除便签 -->
                                <ui:Button Appearance="Transparent"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Icon="Delete20"
                                           Content="删除便签"
                                           FontSize="13"
                                           Padding="8,6"
                                           Foreground="#D83B01"
                                           Click="DeleteButton_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- 关闭按钮（收起贴纸窗口） -->
                    <Button Style="{StaticResource StickyCloseButtonStyle}"
                            ToolTip="关闭便签 (Ctrl+W)"
                            Click="CloseButton_Click">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="16"
                                       Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 正文编辑区：使用定制的 StickyEditorTextBoxStyle，彻底透明绝不变白 -->
        <TextBox x:Name="EditorTextBox"
                 Grid.Row="1"
                 Style="{StaticResource StickyEditorTextBoxStyle}"
                 Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                 CaretBrush="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 IsInactiveSelectionHighlightEnabled="True"
                 SelectionBrush="#3399FF"
                 FontSize="15"
                 FontFamily="Segoe UI, Microsoft YaHei UI"
                 Padding="16,10,16,8" />

        <!-- 3. 底部微型辅助栏：统计字符数与右下角缩放角标 -->
        <Grid Grid.Row="2" Margin="16,0,16,4" VerticalAlignment="Center">
            <!-- 实时字数与状态提示 -->
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                       Opacity="0.55"
                       VerticalAlignment="Center">
                <Run Text="{Binding Content.Length, Mode=OneWay}" /><Run Text=" 字符" />
            </TextBlock>

            <!-- 自动保存状态提示 -->
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                       Opacity="0.4"
                       HorizontalAlignment="Right"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Text="已同步" />
        </Grid>
    </Grid>
    </Border>
</Window>
