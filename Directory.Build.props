<Project>

  <!-- ============================================================ -->
  <!-- 统一版本号管理：所有项目共享同一份版本定义                     -->
  <!-- 方案：Major.Minor.Patch + 基准日起算天数                      -->
  <!-- ============================================================ -->

  <PropertyGroup>
    <Major>1</Major>
    <Minor>1</Minor>
    <Patch>2</Patch>
    <VersionPrefix>$(Major).$(Minor).$(Patch)</VersionPrefix>
    <!-- 基准日：DaysSinceEpoch = today.Subtract(epoch).Days -->
    <FileVersionEpoch>2026-01-01</FileVersionEpoch>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- 共享程序集元数据 -->
    <Company>mcxiaoke</Company>
    <Product>StickyNotes</Product>
    <Authors>$(Company)</Authors>
    <Copyright>Copyright © $(Company) 2026</Copyright>

    <!-- 现代语言特性与桌面配置 -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    质量闸门：把警告当作错误，避免「当前恰好 0 警告」在无 CI 的情况下悄悄退化。
    CS0618（过时 API）暂只提升为警告汇总，不阻断构建 —— 若后续依赖升级引入批量过时告警，
    应先逐条处置再收紧，而不是让构建大面积变红。
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS0618</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!--
    GenerateCustomVersion: 计算并填充版本号 + 注入 AssemblyMetadata。
    BeforeTargets 选择 GetAssemblyVersion 以保证 AssemblyVersion/FileVersion
    在生成 AssemblyInfo 之前已就位。
  -->
  <Target Name="GenerateCustomVersion"
          BeforeTargets="GetAssemblyVersion;GenerateNuspec;GetPackageVersion">

    <!-- 1. 获取 Git short commit（失败不致命） -->
    <Exec Command="git rev-parse --short HEAD"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
    </Exec>

    <!-- 2. 计算构建时间 + DaysSinceEpoch（跨年自动继续递增） -->
    <PropertyGroup>
      <BuildDate>$([System.DateTime]::Now.ToString('yyyyMMdd'))</BuildDate>
      <BuildTimeStamp>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))</BuildTimeStamp>
      <BuildTimeNumeric>$([System.DateTime]::Now.ToString('HHmm'))</BuildTimeNumeric>
      <DaysSinceEpoch>$([System.DateTime]::Now.Subtract($([System.DateTime]::Parse('$(FileVersionEpoch)'))).Days)</DaysSinceEpoch>
      <GitCommitHash Condition="'$(GitCommitHash)' == ''">unknown</GitCommitHash>
    </PropertyGroup>

    <!-- 3. Debug / Release 后缀 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
      <VersionSuffix>debug</VersionSuffix>
    </PropertyGroup>

    <!--
      4. 核心版本号（统一设置）。
      注意：Release 的 Version/InformationalVersion 保持**纯语义版本**（如 1.1.2），
      不再拼入构建日期与提交号 —— 否则同一份源码在不同时间构建会得到不同版本号，
      导致「无法用版本号定位问题」且 CI/本地缓存全部失效。
      构建时间与提交号只进下面的 AssemblyMetadata（供设置页「关于」展示）。
    -->
    <PropertyGroup>
      <Version Condition="'$(Configuration)' == 'Debug'">$(VersionPrefix)-$(VersionSuffix)</Version>
      <Version Condition="'$(Configuration)' != 'Debug'">$(VersionPrefix)</Version>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>

    <!-- 4a. Debug 构建：AssemblyVersion/FileVersion 使用自动生成构建标识 -->
    <PropertyGroup Condition="'$(Configuration)' != 'Release'">
      <AssemblyVersion>$(Major).$(Minor).$(DaysSinceEpoch).0</AssemblyVersion>
      <FileVersion>$(Major).$(Minor).$(DaysSinceEpoch).$(BuildTimeNumeric)</FileVersion>
    </PropertyGroup>

    <!-- 4b. Release 构建：AssemblyVersion/FileVersion 固定为语义版本号 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
      <AssemblyVersion>$(Major).$(Minor).$(Patch).0</AssemblyVersion>
      <FileVersion>$(Major).$(Minor).$(Patch).0</FileVersion>
    </PropertyGroup>

    <!-- 5. 注入 AssemblyMetadata，运行时通过反射读取 -->
    <ItemGroup>
      <AssemblyMetadata Include="GitCommit" Value="$(GitCommitHash)" />
      <AssemblyMetadata Include="BuildTime" Value="$(BuildTimeStamp)" />
      <AssemblyMetadata Include="DaysSinceEpoch" Value="$(DaysSinceEpoch)" />
    </ItemGroup>

    <Message Importance="high"
             Text="=== [StickyNotes 编译信息] Version=$(Version) | AssemblyVersion=$(AssemblyVersion) | FileVersion=$(FileVersion) (天数=$(DaysSinceEpoch)) ===" />
  </Target>

</Project>
